# Copy this file to android/keystore.properties (git-ignored) and fill in your
# release signing credentials. The release APK/AAB is signed with these.
#
# storeFile is resolved relative to android/app/ (so a value of
# "release.keystore" points at android/app/release.keystore).
storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=megatest
keyPassword=CHANGE_ME
