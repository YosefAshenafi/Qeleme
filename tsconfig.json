{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["src/*"],
      "@/features/*": ["src/features/*"],
      "@/components/*": ["src/features/common/components/*"],
      "@/core/*": ["src/core/*"],
      "@/hooks/*": ["src/features/common/hooks/*"],
      "@/services/*": ["src/features/common/services/*"],
      "@/types/*": ["src/features/common/types/*"],
      "@/utils/*": ["src/features/common/utils/*"],
      "@/constants/*": ["src/features/common/constants/*"],
      "@/config/*": ["src/core/config/*"],
      "@/appStyles/*": ["src/features/common/appStyles/*"],
      "@/assets/*": ["assets/*"]
    }
  },
  "extends": "expo/tsconfig.base",
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "src/**/*"
  ]
}
