# Public URL of this gateway (used for payment callbacks)
GATEWAY_PUBLIC_URL=http://localhost:3000

# Main REST API (Trustechit / MegaTest backend)
UPSTREAM_API_URL=https://www.trustechit.com

# Payment provider proxy (Chapa or legacy host — never exposed to the mobile app)
PAYMENT_UPSTREAM_URL=https://api.megatest.app

# AfroMessage OTP
OTP_UPSTREAM_URL=https://api.afromessage.com/api
OTP_API_KEY=
OTP_IDENTIFIER_ID=e80ad9d8-adf3-463f-80f4-7c4b39f7f164
OTP_SENDER_NAME=MegaTest

# Dev-only: accept +251900000000 with OTP 123456
OTP_DEV_BYPASS=false
