# Dependencies (installed during EAS build)
node_modules/

# Local API gateway — not part of the mobile app
server/

# Build artifacts
dist/
.expo/
web-build/
android/app/build/
android/build/
android/.gradle/
ios/build/
ios/Pods/

# Agent / IDE / design tooling
.agents/
.cursor/
.stitch/
.claude/

# Development files
*.log
.DS_Store
*.pem
*.orig.*

# Keystores & secrets (must not ship in build archive)
android/keystore/
android/keystore.properties
android/KEYSTORE_CREDENTIALS.local.txt
android/app/release.keystore*
*.keystore
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.env
.env.*
!.env.example

# Test files
**/__tests__/
**/*.test.*
**/*.spec.*

# Docs (keep README)
*.md
!README.md

# Local helpers not required on EAS (postinstall tolerates missing patch script)
Makefile

# Large media not needed for store builds
*.mov
*.avi

# Old build outputs
*.ipa
*.apk
*.aab

# TypeScript build info
*.tsbuildinfo
