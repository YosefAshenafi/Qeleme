{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../shared/*"],
      "@shared/*": ["../../shared/*"],
      "@/features/*": ["../../shared/features/*"],
      "@/components/*": ["../../shared/components/*"],
      "@/core/*": ["../../shared/core/*"],
      "@/hooks/*": ["../../shared/hooks/*"],
      "@/services/*": ["../../shared/services/*"],
      "@/types/*": ["../../shared/types/*"],
      "@/utils/*": ["../../shared/utils/*"],
      "@/constants/*": ["../../shared/constants/*"],
      "@/config/*": ["../../shared/config/*"],
      "@/assets/*": ["assets/*"]
    }
  },
  "extends": "expo/tsconfig.base",
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../shared/**/*"
  ]
}
